{
  "atomCode": "allure-report",
  "name": "Allure report",
  "version": "1.1.0",
  "description": "Reads allure-results and writes one self-contained HTML report with the counts.",
  "execution": {
    "packagePath": "allure-report.jar",
    "language": "java",
    "target": "$atom_java_path -cp allure-report.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "resultsDir": {
      "label": "allure-results 目录",
      "type": "vuex-input",
      "default": "allure-results"
    },
    "reportDir": {
      "label": "报告输出目录",
      "type": "vuex-input",
      "default": "out/allure-report"
    },
    "title": {
      "label": "报告标题",
      "type": "vuex-input",
      "default": "Allure report"
    },
    "failOnFailure": {
      "label": "有失败用例就让这一步失败",
      "type": "checkbox",
      "default": "false"
    },
    "allowUnreadableReports": {
      "label": "结果文件解析失败也继续（默认 false：解析失败即失败）",
      "type": "boolean",
      "default": "false"
    }
  },
  "output": {
    "total": {
      "type": "string",
      "description": "用例总数"
    },
    "passed": {
      "type": "string",
      "description": "通过"
    },
    "failed": {
      "type": "string",
      "description": "失败"
    },
    "broken": {
      "type": "string",
      "description": "异常中断"
    },
    "skipped": {
      "type": "string",
      "description": "跳过"
    },
    "durationMs": {
      "type": "string",
      "description": "合计耗时（毫秒）"
    },
    "report": {
      "type": "report",
      "description": "构建页内嵌的 HTML 报告"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.4.0"
    }
  }
}
